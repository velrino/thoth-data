      "autoResize": false,
      "lineHeight": 1.25,
      "id": "review-456",
      "groupIds": [],
      "frameId": null,
      "isDeleted": false,
      "boundElements": [],
      "updated": 0,
      "link": null,
      "locked": false,
      "text": "• Per 1,000 reviews, allow $1 before or $2 after for file storage and transfer.\n• Allow $1 per 1,000 reviews for service logs and traces in both designs.\n• The storage allowance covers the extra prepared artifacts in the later design.\n• Estimate covers the named services. Team costs, tax and regional pricing vary.",
      "originalText": "• Per 1,000 reviews, allow $1 before or $2 after for file storage and transfer.\n• Allow $1 per 1,000 reviews for service logs and traces in both designs.\n• The storage allowance covers the extra prepared artifacts in the later design.\n• Estimate covers the named services. Team costs, tax and regional pricing vary.",
      "containerId": null
    },
