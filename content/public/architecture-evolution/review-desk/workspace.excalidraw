      "text": "Infrastructure sizing assumptions",
      "originalText": "Infrastructure sizing assumptions",
      "containerId": null
    },
    {
      "type": "text",
      "x": 55.0,
      "y": 3223.0,
      "width": 1120,
      "height": 118.75,
      "angle": 0,
      "strokeColor": "#26232a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.7,
      "strokeStyle": "solid",
      "roughness": 1.2,
      "opacity": 100,
      "roundness": null,
      "seed": 462601260,
      "version": 5,
      "versionNonce": 831428372,
      "fontSize": 19,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "autoResize": false,
      "lineHeight": 1.25,
      "id": "review-451",
      "groupIds": [],
      "frameId": null,
      "isDeleted": false,
      "boundElements": [],
      "updated": 0,
      "link": null,
      "locked": false,
      "text": "• Each block of 100,000 monthly reviews gets one API, Redis and database allocation.\n• Before budgets $15 API, $10 Redis and $15 database per block.\n• After budgets $30 for both APIs, $15 Redis and $15 database per block.\n• Workers scale every 25,000 reviews at $25 before or $40 after, including file preparation.\n• Round partially used blocks up. Load tests would determine real capacity.",
      "originalText": "• Each block of 100,000 monthly reviews gets one API, Redis and database allocation.\n• Before budgets $15 API, $10 Redis and $15 database per block.\n• After budgets $30 for both APIs, $15 Redis and $15 database per block.\n• Workers scale every 25,000 reviews at $25 before or $40 after, including file preparation.\n• Round partially used blocks up. Load tests would determine real capacity.",
      "containerId": null
    },
