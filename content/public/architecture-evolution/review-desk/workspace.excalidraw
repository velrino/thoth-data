    {
      "type": "text",
      "x": 1450.0,
      "y": 3223.0,
      "width": 1120,
      "height": 95.0,
      "angle": 0,
      "strokeColor": "#26232a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1.7,
      "strokeStyle": "solid",
      "roughness": 1.2,
      "opacity": 100,
      "roundness": null,
      "seed": 462601260,
      "version": 5,
      "versionNonce": 831428372,
      "fontSize": 19,
      "fontFamily": 6,
