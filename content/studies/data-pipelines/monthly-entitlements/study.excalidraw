      "text": "Risks and Safeguards (Shared Unless Marked)",
      "originalText": "Risks and Safeguards (Shared Unless Marked)",
      "fontSize": 25,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
