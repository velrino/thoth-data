      "title": "Monthly Entitlements to the Data Lake",
      "complete": false,
      "steps": [
        {
          "id": "overview",
          "title": "One batch, three delivery designs",
          "description": "Larkspur Library is a fictional subscription service. Each month it records which guides and books its customers can access, then delivers an auditable history to a data lake. A writes every subscription–item pair, B stores subscription grants alongside a snapshot of the monthly catalog, and C delivers immutable Parquet files. The volumes and prices in this study are scenario assumptions and estimates. Zoom in to read the full comparison board, or use the steps to explore each design.",
          "metrics": [
            {
              "label": "Study scale",
              "value": "158M active subscriptions"
            },
            {
              "label": "Designs compared",
              "value": "3"
            }
          ],
          "scene": {
